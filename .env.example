# Postgres connection string (Neon/Supabase both work well with the free tier —
# if using Supabase, use the *pooled* connection string, not the direct one)
DATABASE_URL="postgresql://user:password@host:5432/studyspots"

# Gemini key used by the search agent (lib/agent.ts) — free tier via
# Google AI Studio: https://aistudio.google.com/apikey (no billing needed)
GOOGLE_API_KEY="AIza..."

# Google Maps JS API key (Maps JavaScript API enabled), for the map view
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyARP0SNWUAv1GkLhQR7F__JBGsUsJWfrQU"

# Server-side key for real place search/import (Places API (New) enabled).
# Keep this WITHOUT the NEXT_PUBLIC_ prefix — it's used only in API routes,
# never sent to the browser. Can be a separate key from the Maps one above,
# restricted to Places API (New) with no HTTP referrer restriction (since
# it's called server-side, not from the browser).
GOOGLE_PLACES_API_KEY="..."

# --- NextAuth (Google sign-in) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="..."

# Generate with: npx auth secret   (or `openssl rand -base64 32`)
NEXTAUTH_SECRET="..."
NEXTAUTH_URL="http://localhost:3000"

# --- Photo upload (Cloudinary, unsigned upload — free tier, no server secret) ---
# 1. Sign up at cloudinary.com (free)
# 2. Dashboard shows your "Cloud name" — put it below
# 3. Settings > Upload > Add upload preset > Signing Mode: "Unsigned" > save,
#    then put that preset's name below
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="..."
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="..."
